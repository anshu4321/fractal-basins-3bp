\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Active learning versus uniform sampling at matched labeling budget. (a) In 2D, AL consistently outperforms uniform sampling. (b) In 6D, uniform sampling performs as well or better than AL at every budget tested. Error bars are $2\sigma $ over 5 seeds.\relax }}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:al}{{1}{3}{Active learning versus uniform sampling at matched labeling budget. (a) In 2D, AL consistently outperforms uniform sampling. (b) In 6D, uniform sampling performs as well or better than AL at every budget tested. Error bars are $2\sigma $ over 5 seeds.\relax }{figure.caption.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}The Scaling-Law Question}{3}{section.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Architecture-specific training}{3}{subsection.5.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Matched-compute protocol}{3}{subsection.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Test error versus training set size on a log-log scale. Green band shows the GOY prediction $\pm 2\sigma $. (a) Under architecture-specific training (MLP at 60 epochs, S3BodyNet at 200 epochs), both slopes fall within the GOY band. (b) Under a matched-compute protocol (identical optimizer, learning rate, and gradient-update budget for both architectures), slopes are flat or inverted, far from the GOY prediction.\relax }}{4}{figure.caption.2}\protected@file@percent }
\newlabel{fig:scaling}{{2}{4}{Test error versus training set size on a log-log scale. Green band shows the GOY prediction $\pm 2\sigma $. (a) Under architecture-specific training (MLP at 60 epochs, S3BodyNet at 200 epochs), both slopes fall within the GOY band. (b) Under a matched-compute protocol (identical optimizer, learning rate, and gradient-update budget for both architectures), slopes are flat or inverted, far from the GOY prediction.\relax }{figure.caption.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Why the disagreement}{4}{subsection.5.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Training diagnostics for four representative cells from the matched-compute protocol. Blue: training loss (log scale). Orange: validation macro-F1. At $N = 10$k, the MLP overfits (training loss near zero, validation F1 declines from peak). At $N = 300$k, both architectures are undertrained (training loss still falling at budget end). This differential convergence flattens the measured slope.\relax }}{5}{figure.caption.3}\protected@file@percent }
\newlabel{fig:diagnostic}{{3}{5}{Training diagnostics for four representative cells from the matched-compute protocol. Blue: training loss (log scale). Orange: validation macro-F1. At $N = 10$k, the MLP overfits (training loss near zero, validation F1 declines from peak). At $N = 300$k, both architectures are undertrained (training loss still falling at budget end). This differential convergence flattens the measured slope.\relax }{figure.caption.3}{}}
