# 3bp_paper.mplstyle -- paper-grade PDF output (a2paper 10pt doc style)
figure.figsize      : 5.0, 3.5
figure.dpi          : 150
savefig.dpi         : 600
savefig.bbox        : tight
savefig.pad_inches  : 0.1
savefig.format      : pdf

font.family         : serif
font.serif          : Computer Modern Roman, cmr10, DejaVu Serif
mathtext.fontset    : cm
text.usetex         : False

axes.labelsize      : 12
axes.titlesize      : 14
xtick.labelsize     : 10
ytick.labelsize     : 10
legend.fontsize     : 10

axes.linewidth      : 0.8
axes.grid           : False
axes.spines.top     : False
axes.spines.right   : False

lines.linewidth     : 1.6
lines.markeredgewidth : 0.7
lines.markeredgecolor : black
lines.markersize    : 6

legend.frameon      : False

image.cmap          : viridis
